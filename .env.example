# Context Synthesizer — environment variables
#
# This app is a frontend-only demo: it has NO required secrets and NO backend
# credentials. The build succeeds with zero environment variables set; the
# values below are optional overrides with sane defaults baked into the code.
#
# Only variables prefixed with VITE_ are exposed to the built client bundle.
# They are inlined at build time and are PUBLIC — never store secrets here.

# Canonical public origin used for <link rel="canonical">, og:url, JSON-LD and
# /sitemap.xml. No trailing slash.
# Default: https://enterprise-thread.lovable.app
VITE_SITE_URL=https://enterprise-thread.lovable.app
